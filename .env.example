# Web service
WELL_SEISMIC_HOST=127.0.0.1
WELL_SEISMIC_PORT=725

# This extracted distribution is an interface shell.  Keep task model
# runners disabled until an external, reviewed model package is installed.
WELLFUSE_MODEL_MODE=interfaces_only
WELLFUSE_DISABLE_TASK_MODELS=1
WELLFUSE_DISABLE_LAYERPULSE=1

# Optional local control-plane paths. Source seismic/LAS files remain in place;
# these settings point only to the small SQLite state file and frozen manifests.
WELL_SEISMIC_STATE_DB=
# Artifact resolution is deterministic: WELLFUSE_ARTIFACT_ROOT first, then
# WELLFUSE_PROJECT_ROOT/artifacts, then the self-contained runtime bundle.
# A configured missing path never triggers discovery of another checkout.
WELLFUSE_ARTIFACT_ROOT=
# Optional runtime overrides. By default the platform uses the self-contained
# runtime/wellfuse source bundle and runtime/python-wellfuse/python.exe.
WELLFUSE_PROJECT_ROOT=
WELLFUSE_PYTHON=
# Optional Direct12B-only runtime source override. The active release pointer's
# wellfuse_project_root is used before the generic WELLFUSE_PROJECT_ROOT.
WELLFUSE_DIRECT12B_PROJECT_ROOT=
# Optional external NF4 base-model directory or Hugging Face model id.
WELLFUSE_DIRECT12B_MODEL_PATH=

# Kimi Open Platform. Copy this file to .env and fill the server-side key there.
# Never place the key in frontend files, configs/llm.yaml, logs, or committed files.
WELL_SEISMIC_LLM_ENABLED=false
WELL_SEISMIC_LLM_PROVIDER=kimi
WELL_SEISMIC_LLM_API_MODE=chat_completions
WELL_SEISMIC_LLM_MODEL=kimi-k3
WELL_SEISMIC_LLM_BASE_URL=https://api.moonshot.cn/v1
WELL_SEISMIC_LLM_REASONING_EFFORT=high
WELL_SEISMIC_LLM_TIMEOUT_SECONDS=60
WELL_SEISMIC_LLM_MAX_RETRIES=2
WELL_SEISMIC_LLM_MAX_OUTPUT_TOKENS=4096
WELL_SEISMIC_LLM_MIN_CONFIDENCE=0.82
WELL_SEISMIC_LLM_MAX_CALLS_PER_TASK=24
WELL_SEISMIC_LLM_MAX_CONTEXT_CHARS=16000
WELL_SEISMIC_LLM_SEND_FILE_NAMES=false
WELL_SEISMIC_LLM_USE_SYSTEM_PROXY=false

# Keep the real key only in .env. Never expose it to frontend code or commit it.
KIMI_API_KEY=
# Optional aliases; WELL_SEISMIC_LLM_* above take precedence.
KIMI_BASE_URL=
KIMI_MODEL=
# The official Kimi variable is also accepted when KIMI_API_KEY is empty:
# MOONSHOT_API_KEY=
